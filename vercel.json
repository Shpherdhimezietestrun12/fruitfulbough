{
  "version": 2,
  "builds": [
    { "src": "mock/app.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "mock/app.py" },
    { "src": "/", "dest": "/public/Home.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
