{
  "version": 2,
  "builds": [
    { "src": "mock/app.py", "use": "@vercel/python" },
    { "src": "splash-screen/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "mock/app.py" },
    { "src": "/", "dest": "/splash-screen/Home.html" },
    { "src": "/(.*)", "dest": "/splash-screen/$1" }
  ]
}
